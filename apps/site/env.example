# Copy this file to .env for local development

# Production domain (required for production)
NEXT_PUBLIC_PRODUCTION_DOMAIN=toddagriscience.com

# Base URL for canonical links and metadata (optional, auto-detected)
NEXT_PUBLIC_BASE_URL=https://toddagriscience.com

# Vercel system environment variables. Populated by Vercel itself, so leave
# these unset locally and never add them by hand. On preview deployments they
# are what makes Supabase auth emails link back to the preview rather than
# production.
#   VERCEL_ENV: "production" | "preview" | "development"
#   VERCEL_BRANCH_URL: stable per-branch host, preferred for previews
#   VERCEL_URL: per-deployment host, used when the branch URL is absent
# Both the NEXT_PUBLIC_-prefixed and unprefixed forms are read: the unprefixed
# ones for server runtime, the prefixed ones because Next.js inlines those at
# build time.
#
# Two dashboard settings gate this feature. Neither is an environment variable
# anyone types in, but without them the preview redirect will not happen:
#
# 1. Vercel -> Project -> Settings -> Environment Variables -> tick
#    "Enable access to System Environment Variables". This checkbox governs
#    every VERCEL_* variable above, prefixed and unprefixed alike; with it off
#    none of them exist and this helper falls back to NEXT_PUBLIC_BASE_URL.
#    https://vercel.com/docs/environment-variables/system-environment-variables
#
# 2. Supabase -> Authentication -> URL Configuration -> Redirect URLs. Supabase
#    consults this allow-list before every redirect and quietly substitutes the
#    Site URL when nothing matches. Add:
#      https://*-todd-marketing.vercel.app/**
#      http://localhost:3000/**
#    The branch URL is preferred over the per-deployment URL precisely so this
#    one wildcard covers every future push instead of one entry per deployment.
#    https://supabase.com/docs/guides/auth/redirect-urls
#
# NEXT_PUBLIC_VERCEL_ENV=preview
# NEXT_PUBLIC_VERCEL_BRANCH_URL=nightcrawler-git-my-branch-todd-marketing.vercel.app
# NEXT_PUBLIC_VERCEL_URL=nightcrawler-abc123-todd-marketing.vercel.app

# Optional base URL for seed product imagery stored in Cloudflare R2.
NEXT_PUBLIC_SEED_IMAGE_BASE_URL=https://example-public-bucket.r2.dev

# Locale detection settings
NEXT_LOCALE=en  # Force default locale (optional)

# Other environment variables
NODE_ENV=development

# The URL/IP for the backend
BACKEND_HOST="http://localhost:8080"

# These keys are real and appropriate to be public.
NEXT_PUBLIC_SUPABASE_PROJECT_ID="pexzjinboynpudrgsbve"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBleHpqaW5ib3lucHVkcmdzYnZlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjIyNjkzODksImV4cCI6MjA3Nzg0NTM4OX0.n-ikH7U_r8zOFd3LnM62GIefOyngrSRWLlHqjgL7YeM"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_88XRibYZf0_4dVYVZ2eC7Q_nnH2l33e"

# This SHOULD NOT be public. This is for use of `admin`.
SUPABASE_SECRET_KEY="secret"

# Enable debug logging
DEBUG=true

# Disable telemetry (Next.js)
NEXT_TELEMETRY_DISABLED=1

# Posthog Analytics, both of these keys are appropriate to be public
NEXT_PUBLIC_POSTHOG_KEY=phc_dNQKsvNxp8t3XYid8xYidmEhzZxBXMqIAwJe0v0VSY8
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Script URLs for submitting form data, private
CONTACT_GOOGLE_SCRIPT_URL="https://google.com"
EXTERNSHIP_GOOGLE_SCRIPT_URL="https://google.com"
INTERNAL_APPLICATION_GOOGLE_SCRIPT_URL="https://google.com"

# Database URL, private. There's not a separate URL for local/staging/production.
DATABASE_URL="postgresql://USERNAME:PASSWORD@URL:PORT/DATABASE"
# Not absolutely required in dev, see below.
DATABASE_PEM_CERT="pem-cert"

# For local databases ONLY.
NODE_TLS_REJECT_UNAUTHORIZED='0'

# Database settings for connecting to locally hosted databases (i.e. docker/manually configuring databases) via Drizzle Studio. 
LOCAL_DATABASE_HOST="localhost"
LOCAL_DATABASE_PORT=5432
LOCAL_DATABASE_USER="postgres"
LOCAL_DATABASE_PASSWORD="Test123!"
LOCAL_DATABASE_DATABASE="postgres"

# Database settings for connecting to the shared staging database via Drizzle Studio.
STAGING_DATABASE_HOST="my-database-host"
STAGING_DATABASE_PORT=5432
STAGING_DATABASE_USER="postgres"
STAGING_DATABASE_PASSWORD="Test123!"
STAGING_DATABASE_DATABASE="postgres"

# Database settings for the remote database cluster. Realisitcally, you'll never touch this. This is 90% Vercel only.
PROD_DATABASE_HOST="my-database-host"
PROD_DATABASE_PORT=5432
PROD_DATABASE_USER="postgres"
PROD_DATABASE_PASSWORD="my-password"
PROD_DATABASE_DATABASE="production-database"

# API key for OpenAI for embeddings.
OPENAI_EMBEDDINGS_KEY="secret"

# Stripe secret key for billing/subscription data. Private, never expose publicly.
STRIPE_SECRET_KEY="sk_test_your_key_here"

# Stripe publishable key for embedded payment forms. Safe to expose to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_key_here"

# Stripe webhook signing secret for /api/stripe/webhook. Private.
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Shared secret for the Sanity on-demand revalidation webhook (/api/revalidate). Private.
# Generate with `openssl rand -hex 32`; the same value goes in the Sanity webhook's
# x-revalidate-secret header (sanity.io/manage -> API -> Webhooks).
SANITY_REVALIDATE_SECRET="your-random-secret-here"

# SMTP settings for internal seed-order notifications. Optional until email delivery is configured.
ORDER_EMAIL_HOST="smtp.example.com"
ORDER_EMAIL_PORT="587"
ORDER_EMAIL_SECURE="false"
ORDER_EMAIL_USER="smtp-user"
ORDER_EMAIL_PASSWORD="smtp-password"
ORDER_EMAIL_FROM="orders@toddagriscience.com"
INTERNAL_ORDER_EMAIL_TO="orders@toddagriscience.com"

# New Relic keys for monitoring. Private.
NEW_RELIC_ENABLED="false"
NEW_RELIC_APP_NAME="TODD_SITE_TESTING"
NEW_RELIC_LICENSE_KEY="secret"

# Upstash Redis for IP-based rate limiting on public write endpoints (CMS
# forms, signup, activation-email resends). REQUIRED IN PRODUCTION: rate
# limiting fails open, so a production deploy without these has no rate
# limiting at all — silently. May be omitted for local dev / CI / preview,
# where failing open keeps things working. Provision via the Vercel
# Marketplace Upstash integration, which injects these automatically.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"