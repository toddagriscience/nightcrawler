# Copy this file to .env.local for local development

NODE_ENV=development

# Supabase authentication
NEXT_PUBLIC_SUPABASE_PROJECT_ID="pexzjinboynpudrgsbve"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_88XRibYZf0_4dVYVZ2eC7Q_nnH2l33e"

# Required to send approval emails from the internal dashboard
SUPABASE_SECRET_KEY=

# Public site URL used in approval email links
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Database URL
DATABASE_URL="postgresql://postgres:Test123!@localhost:5432/postgres"

# CA certificate for the managed cluster, from the provider dashboard. Required
# whenever DATABASE_URL is not a local database: the connection is verified
# against it, and startup fails by name if it is missing. A local database
# connects without TLS and needs nothing here.
DATABASE_PEM_CERT=

# Local databases reached under a name other than localhost / 127.0.0.1 / ::1 —
# a docker-compose service, a LAN address. Comma-separated, and only ever for
# databases on your own machine; naming a shared cluster here drops its TLS.
# DATABASE_PLAINTEXT_HOSTS="host.docker.internal,db"
